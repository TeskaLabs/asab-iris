meta {
  name: Render PDF
  type: http
  seq: 2
}

put {
  url: {{BASE_URL}}/render
  body: json
  auth: inherit
}

params:query {
  format: pdf
  template: /Templates/General/test.md
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "order_id": 123,
    "order_creation_date": "2020-01-01 14:14:52",
    "company_name": "Test Company",
    "city": "Mumbai",
    "state": "MH"
  }
}

docs {
  Render a template with the JSON request body and return application/pdf.
}
