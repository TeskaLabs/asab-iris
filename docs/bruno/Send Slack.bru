meta {
  name: Send Slack
  type: http
  seq: 4
}

put {
  url: {{BASE_URL}}/send_slack
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "type": "slack",
      "body": {
        "template": "/Templates/Slack/message.md",
        "channel_id": "U0124ABCD",
        "params": {
          "content": "This is a Slack message ;-)"
        }
      }
  }
    
    
}
